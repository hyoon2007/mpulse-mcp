# Secrets only. Copy to .env (or set in the Claude Desktop config "env" block).
# These are the PRE-ISSUED mPulse API tokens (generated in mPulse: your name ->
# Account -> Generate/Revoke API Token). They are NOT the short-lived security
# token — that is minted at runtime from these.

# Default API token, used by any app whose api_token_env is not overridden.
MPULSE_API_TOKEN=replace-me

# Per-app override example (referenced by mpulse_apps.json -> api_token_env):
# MPULSE_API_TOKEN_APP_B=replace-me-too

# Optional: point the server at a specific registry file (else it looks for
# ./mpulse_apps.json in the working directory).
# MPULSE_APPS_CONFIG=/Users/hyoon/Projects/mpulse-mcp/mpulse_apps.json
